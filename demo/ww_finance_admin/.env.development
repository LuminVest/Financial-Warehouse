# ============================================
#  开发环境配置
#  本地开发用，不会被提交到 git（见 .gitignore）
# ============================================

# 开发调试模式开关
#   true  → 本地假登录：直接 admin / 123456，不调后端
#   false → 真实后端接口：POST /admin/core/login
VITE_DEV_MOCK_LOGIN=false

# 本地假登录的默认账号密码（仅 DEV_MOCK_LOGIN=true 时生效）
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=123456
